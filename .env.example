# discord-grok-plugin configuration
# Copy this file to .env (in the directory you run the bot from) or set the variables in your environment.
# Never commit real secrets.

# === Required ===
DISCORD_TOKEN=your_discord_bot_token_here

# === LLM keys (at least one recommended for real replies) ===
# XAI takes precedence for Grok models (https://api.x.ai/v1)
XAI_API_KEY=your_xai_api_key_here
# OPENAI_API_KEY=sk-your-openai-or-compatible-key

# === Channel scoping (optional) ===
# If neither is set the bot will respond in ANY channel it can read (use with care on large servers).
# DISCORD_CHANNEL_ID=1513374433367036005
# DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432

# === LLM tuning (optional) ===
# LLM_MODEL=grok-3-mini
# LLM_MAX_TOKENS=900

# === State directory (optional) ===
# Defaults to ~/.claude/channels/discord/context  (same as Grok build scheduler context)
# Set this if you want the plugin + any scheduler prompts to share the exact same short-term memory JSONs.
# DISCORD_STATE_DIR=C:\Users\yourname\.claude\channels\discord
# On Unix: /home/yourname/.claude/channels/discord
